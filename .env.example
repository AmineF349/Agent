# =============================================================================
# Power Market Intelligence Agent - Environment Configuration
# =============================================================================
# Copiez ce fichier en .env et remplissez vos clés (toutes optionnelles)
# L'application fonctionne 100% sans clé grâce aux APIs publiques et fallbacks locaux

# Ce fichier est créé automatiquement par setup.ps1 / setup.sh (copie de .env.example).
# Il est chargé depuis la racine du dépôt quel que soit le répertoire de lancement.

# --- Backend / Frontend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=8501
# URL du backend vue par le frontend (start.ps1 / start.sh la positionnent automatiquement)
BACKEND_URL=http://localhost:8000

# --- Chemins (optionnel - par défaut résolus automatiquement à partir du dépôt) ---
# GENERATED_DIR=C:\Users\moi\Documents\PMIA\generated     # présentations PPTX/DOCX/PDF (défaut : backend/generated)
# KNOWLEDGE_BASE_DIR=                                        # défaut : knowledge_base/ à la racine
# DATA_SAMPLES_DIR=                                          # défaut : backend/data_samples
# PMIA_ENV_FILE=                                             # défaut : .env à la racine du dépôt

# --- Proxy d'entreprise (optionnel) ---
# Les scripts de lancement ajoutent automatiquement localhost,127.0.0.1 à NO_PROXY.
# HTTPS_PROXY=http://proxy.entreprise.local:8080
# HTTP_PROXY=http://proxy.entreprise.local:8080
# REQUESTS_CA_BUNDLE=C:\chemin\ca-entreprise.pem

# --- APIs Publiques Gratuites (aucune clé requise) ---
# Energy-Charts.info - Gratuit, sans clé : https://api.energy-charts.info
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info

# Open-Meteo - Gratuit, sans clé : https://open-meteo.com/
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ENTSO-E Transparency - Gratuit avec inscription : https://transparency.entsoe.eu/
# Créez un compte gratuit et générez votre token ici : https://transparency.entsoe.eu/usrm/user/createAccount
# Optionnel : si vide, l'app utilise Energy-Charts + mock data
ENTSOE_API_KEY=
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api

# --- LLM APIs (Optionnel - Fallback local si vide) ---
# OpenAI - https://platform.openai.com/api-keys (payant, mais optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI - Optionnel
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Sécurité ---
SECRET_KEY=change-me-in-production-power-market-intelligence-2024
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Feature Flags ---
ENABLE_LLM=true
ENABLE_ENTSOE=false
MOCK_DATA_FALLBACK=true
