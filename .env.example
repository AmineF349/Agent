# =============================================================================
# Power Market Intelligence Agent - Environment Configuration
# =============================================================================
# Copiez ce fichier en .env et remplissez vos clés (toutes optionnelles)
# L'application fonctionne 100% sans clé grâce aux APIs publiques et fallbacks locaux

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=8501
# Adresse d'ecoute. 127.0.0.1 = local uniquement (aucune regle de pare-feu).
# Passez a 0.0.0.0 seulement pour exposer l'API sur le reseau.
BACKEND_HOST=127.0.0.1
# URL utilisee par le frontend Streamlit pour joindre le backend.
# En natif Windows : http://127.0.0.1:8000
# Sous docker-compose : http://backend:8000 (injecte par le compose)
BACKEND_URL=http://127.0.0.1:8000

# --- APIs Publiques Gratuites (aucune clé requise) ---
# Energy-Charts.info - Gratuit, sans clé : https://api.energy-charts.info
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info

# Open-Meteo - Gratuit, sans clé : https://open-meteo.com/
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ENTSO-E Transparency - Gratuit avec inscription : https://transparency.entsoe.eu/
# Créez un compte gratuit et générez votre token ici : https://transparency.entsoe.eu/usrm/user/createAccount
# Optionnel : si vide, l'app utilise Energy-Charts + mock data
ENTSOE_API_KEY=
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api

# --- LLM APIs (Optionnel - Fallback local si vide) ---
# OpenAI - https://platform.openai.com/api-keys (payant, mais optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI - Optionnel
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Database (OPTIONNEL) ---
# Aucun module du backend n'ouvre de connexion SQL : la persistance reelle est
# fichier (backend/generated/). Laissez cette valeur VIDE en natif Windows.
# L'hote "postgres" ci-dessous n'existe que dans le reseau Docker ; il est
# injecte par docker-compose.yml (section environment:) qui a precedence.
DATABASE_URL=
# Exemple si vous disposez d'un PostgreSQL accessible :
# DATABASE_URL=postgresql://power_user:power_pass@localhost:5432/power_market

# --- Sécurité ---
SECRET_KEY=change-me-in-production-power-market-intelligence-2024
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Feature Flags ---
ENABLE_LLM=true
ENABLE_ENTSOE=false
MOCK_DATA_FALLBACK=true
